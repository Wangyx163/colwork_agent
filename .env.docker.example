# Copy to .env next to docker-compose.yaml, then edit. Compose reads .env
# automatically. This file is the container equivalent of .env.local; never
# commit the filled-in copy.

# --- database ---------------------------------------------------------------
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=55432

# --- application ------------------------------------------------------------
# At least 16 bytes. Set this so virtual sessions survive a restart.
COLWORK_SESSION_SECRET=replace_with_a_random_32_byte_secret
WORKBENCH_PORT=8766

# local keeps final organization on-device; bailian only after explicit
# authorization to send task content to the model provider.
RESULT_PROCESSING=local

# --- the meeting to serve ---------------------------------------------------
# Both files must sit in ./meetings, which is mounted read-only into /app.
MEETING_EXTRACTION_FILE=extraction.json
MEETING_TRANSCRIPT_FILE=transcript.txt
MEETING_ORGANIZATION=你的团队
MEETING_COORDINATOR=会议负责人
# Space separated. Display names must not contain spaces.
MEETING_PARTICIPANTS=甲 乙 丙

# --- Feishu (only for `--profile feishu`) -----------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
