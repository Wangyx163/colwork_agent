# Copy to .env.local through scripts/setup_postgres.ps1.
# Never use the example credential outside a disposable local environment.
DATABASE_URL=postgresql://colwork_app:replace_me@127.0.0.1:55432/colwork_agent
# At least 16 bytes. Set this in production-like runs so virtual sessions survive restarts.
COLWORK_SESSION_SECRET=replace_with_a_random_32_byte_secret
COLWORK_ALLOW_CONTRIBUTION_ANALYSIS=false
# local keeps task-result processing on-device; set bailian only after explicit authorization.
COLWORK_RESULT_PROCESSING_MODE=local
# Feishu custom app credentials. Required only for `feishu-serve` without --dry-run.
# Create the app at https://open.feishu.cn and never commit the secret.
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
# Long connection carries its own encryption and authentication, so these two
# stay empty until events arrive over a public webhook instead.
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
